mainnet.seeder.zfnd.org {
    dnsseed {
        network mainnet
        # Bootstrap peers:
        # - DNS seeders (ECC, str4d)
        # - ZF hosted nodes (zfnd-prod-zebra, zfnd-dev-zebra)
        # - Known good external peer IPs
        bootstrap_peers dnsseed.z.cash:8233 dnsseed.str4d.xyz:8233 34.138.164.8:8233 35.196.173.72:8233 34.73.119.93:8233 34.138.153.17:8233 104.196.205.12:8233 104.196.189.93:8233 18.27.125.103:8233
        # ZF hosted IPs: 34.138.164.8, 35.196.173.72, 34.73.119.93 (prod)
        #                34.138.153.17, 104.196.205.12, 104.196.189.93 (dev)
        crawl_interval 30m
        record_ttl 600
    }
    log {
        class denial error
    }
}

